# Copy this file to .env.local, .env.dev, or .env.prod and set only technical
# overrides. Never store tokens, passwords, API keys, or other secrets here.

BEAM_REGISTRY_URL=http://localhost:4201
BEAM_AUTH_URL=http://localhost:3004
BEAM_API_URL=http://localhost:3002
BEAM_AGENT_SOCKET="$HOME/.beam/agent.sock"

# human, json, or quiet
BEAM_OUTPUT=human

# Optional. When unset, beam uses the standard user configuration directory.
# BEAM_CONFIG_DIR="$HOME/.config/beam"
